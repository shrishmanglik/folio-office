    "@tiptap/starter-kit": "^3.0.0",
    "docx": "^9.5.1",
    "dompurify": "^3.2.6",
    "exceljs": "^4.4.0",
    "fast-formula-parser": "1.0.19",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
