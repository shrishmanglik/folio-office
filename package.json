{
  "name": "folio-office",
  "version": "0.7.0",
  "private": true,
  "description": "Offline documents, spreadsheets, presentations and notebooks with a shared CLI and MCP engine.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
